# Copy to config.env and edit. config.env is gitignored.

# --- Operata -----------------------------------------------------------------
# Create the key in the Operata console: Group Settings > API Management >
# Create New Key. This is NOT the REST token under Settings > Config > API.
OPERATA_API_KEY="paste-your-key-here"

# The Operata MCP API-key endpoint.
OPERATA_MCP_ENDPOINT="https://api.operata.io/v1/mcp"

# --- AWS ---------------------------------------------------------------------
AWS_REGION="us-west-2"

# Any Claude model your account has access to in AWS_REGION.
# List them: aws bedrock list-inference-profiles --region "$AWS_REGION"
MODEL_ID="us.anthropic.claude-sonnet-5"

# --- Resource names (change only if they collide with something you own) -----
GATEWAY_NAME="operata-mcp-gateway"
TARGET_NAME="operata"
GATEWAY_ROLE_NAME="OperataMcpGatewayRole"
PROVIDER_NAME="operata-api-key"
FUNCTION_NAME="operata-incident-orchestrator"
LAMBDA_ROLE_NAME="OperataIncidentOrchestratorRole"

# How many tool-calling rounds the model may take before the loop stops.
MAX_TOOL_TURNS="12"
