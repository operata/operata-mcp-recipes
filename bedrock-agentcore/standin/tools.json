[
  {
    "name": "get_schema",
    "description": "Return the data schema: services, column paths, query types, aggregate functions and filter operators. Call this before building a traces_query.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query_reason": {
          "type": "string",
          "description": "Why you are calling this tool"
        }
      }
    }
  },
  {
    "name": "knowledge",
    "description": "Search the Operata knowledge base: features, CX observability concepts and troubleshooting.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
    "name": "list_groups",
    "description": "List the groups this account can access.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "switch_group",
    "description": "Set the active group for the session.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string"
        }
      },
      "required": [
        "groupId"
      ]
    }
  },
  {
    "name": "traces_list",
    "description": "List and search traces with filtering, sorting and cursor pagination.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "startTime": {
          "type": "string",
          "description": "ISO 8601 UTC, e.g. 2026-01-01T00:00:00Z"
        },
        "endTime": {
          "type": "string",
          "description": "ISO 8601 UTC, e.g. 2026-01-01T00:00:00Z"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Objects with a path plus an operator, e.g. {\"path\": \"SpanName\", \"eq\": \"cx.interaction.agent\"}"
        },
        "sort": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "object"
        },
        "groupId": {
          "type": "string",
          "description": "Defaults to the active group"
        }
      },
      "required": [
        "startTime",
        "endTime"
      ]
    }
  },
  {
    "name": "traces_query",
    "description": "Run analytical queries over traces. Query types scalar, series, table, rate and facet can be combined in one call; each query has a key and a service.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "startTime": {
          "type": "string",
          "description": "ISO 8601 UTC, e.g. 2026-01-01T00:00:00Z"
        },
        "endTime": {
          "type": "string",
          "description": "ISO 8601 UTC, e.g. 2026-01-01T00:00:00Z"
        },
        "queries": {
          "type": "object",
          "description": "Arrays per query type, e.g. {\"scalar\": [{\"key\": \"mos\", \"service\": \"agent_interaction\", \"aggregates\": [{\"name\": \"avg_mos\", \"fn\": \"avg\", \"path\": \"mos\"}]}], \"facet\": [{\"key\": \"by_isp\", \"service\": \"agent_interaction\", \"by\": \"network.isp\"}]}"
        },
        "groupId": {
          "type": "string",
          "description": "Defaults to the active group"
        }
      },
      "required": [
        "startTime",
        "endTime",
        "queries"
      ]
    }
  },
  {
    "name": "traces_get",
    "description": "Get one trace by ID as OpenTelemetry JSON with all spans and logs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "traceId": {
          "type": "string",
          "description": "32 hex characters"
        },
        "includeInternal": {
          "type": "boolean"
        },
        "groupId": {
          "type": "string",
          "description": "Defaults to the active group"
        }
      },
      "required": [
        "traceId"
      ]
    }
  },
  {
    "name": "traces_insights",
    "description": "Return the insights (detected issues and anomalies) for a trace.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "traceId": {
          "type": "string"
        },
        "groupId": {
          "type": "string",
          "description": "Defaults to the active group"
        },
        "query_reason": {
          "type": "string",
          "description": "Why you are calling this tool"
        }
      },
      "required": [
        "traceId"
      ]
    }
  },
  {
    "name": "traces_span_logs",
    "description": "Return paginated logs for one span: softphone logs, CCP events and other diagnostics.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "traceId": {
          "type": "string"
        },
        "spanId": {
          "type": "string",
          "description": "16 hex characters"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "object"
        },
        "groupId": {
          "type": "string",
          "description": "Defaults to the active group"
        }
      },
      "required": [
        "traceId",
        "spanId"
      ]
    }
  },
  {
